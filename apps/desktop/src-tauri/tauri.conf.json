{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "THOTH",
  "version": "0.1.0",
  "identifier": "dev.thoth.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build && pnpm prepare:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "THOTH",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      },
      {
        "label": "voice-overlay",
        "title": "THOTH Voice",
        "width": 420,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:7710 ws://127.0.0.1:7710 http://localhost:7710 ws://localhost:7710"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/THOTH Accessibility Helper.app": "THOTH Accessibility Helper.app",
      "resources/runtime": "runtime",
      "resources/models": "models",
      "resources/runtime-manifest.json": "runtime-manifest.json"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
