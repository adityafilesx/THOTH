# THOTH daemon configuration (copy to .env — never commit .env)
# Secrets do NOT belong here or in .env: use the macOS Keychain.

# --- Daemon ---
THOTH_HOST=127.0.0.1
THOTH_PORT=7710
# SQLite database path (created on first run / via `make migrate`)
THOTH_DB_PATH=./data/thoth.db
# Directory for JSONL structured logs
THOTH_LOG_DIR=./data/logs
# Log level: DEBUG | INFO | WARNING | ERROR
THOTH_LOG_LEVEL=INFO

# --- Safety ---
# Comma-separated absolute paths the daemon may treat as trusted workspaces (R1 auto-run)
THOTH_TRUSTED_WORKSPACES=
# Seconds an approval remains valid after being granted
THOTH_APPROVAL_TTL_SECONDS=120
# Bounded recovery limits
THOTH_MAX_RETRIES_PER_STEP=2
THOTH_MAX_RETRIES_PER_TASK=5

# --- Model (Phase 3+; key is resolved from Keychain, never from env) ---
THOTH_PLANNER=mock
# THOTH_MODEL=claude-fable-5

# --- Desktop dev ---
VITE_DAEMON_URL=http://127.0.0.1:7710
