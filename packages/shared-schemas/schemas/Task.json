{
  "$defs": {
    "ExecutionPlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PlanStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "summary",
        "steps"
      ],
      "title": "ExecutionPlan",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "declared_risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "status": {
          "$ref": "#/$defs/StepStatus",
          "default": "pending"
        },
        "verification_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Passed"
        },
        "verification_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Detail"
        }
      },
      "required": [
        "index",
        "title",
        "tool_name",
        "declared_risk"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "RiskLevel": {
      "description": "R0 read-only \u00b7 R1 reversible local \u00b7 R2 external side effect \u00b7\nR3 destructive/highly sensitive (blocked by default).\n\nTotally ordered so that ``max()`` expresses the no-downgrade rule.",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "StepStatus": {
      "enum": [
        "pending",
        "running",
        "verifying",
        "succeeded",
        "failed",
        "skipped",
        "cancelled"
      ],
      "title": "StepStatus",
      "type": "string"
    },
    "TaskSource": {
      "enum": [
        "text",
        "voice"
      ],
      "title": "TaskSource",
      "type": "string"
    },
    "TaskState": {
      "enum": [
        "RECEIVED",
        "UNDERSTANDING",
        "PLANNING",
        "RISK_REVIEW",
        "WAITING_FOR_APPROVAL",
        "EXECUTING",
        "VERIFYING",
        "RECOVERING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "TaskState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/TaskSource"
    },
    "state": {
      "$ref": "#/$defs/TaskState",
      "default": "RECEIVED"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Summary"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "goal",
    "source"
  ],
  "title": "Task",
  "type": "object"
}
